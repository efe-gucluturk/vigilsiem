# VigilSIEM configuration. Copy to .env (never commit .env).
# Every secret MUST be generated, never reused from this file:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Required ---------------------------------------------------------------
# HMAC key for JWT + CSRF tokens (>= 32 chars). The app refuses to start without it.
VIGIL_JWT_SECRET=

# --- Storage ----------------------------------------------------------------
VIGIL_DATABASE_URL=sqlite+aiosqlite:///./data/vigilsiem.db
# PostgreSQL alternative: postgresql+asyncpg://user:pass@host/db

# --- Admin bootstrap (hash only; generate with `python -m scripts.manage_admin hash`) ---
VIGIL_ADMIN_USERNAME=admin
VIGIL_ADMIN_PASSWORD_HASH=

# --- Hardening knobs --------------------------------------------------------
VIGIL_COOKIE_SECURE=true
VIGIL_JWT_TTL_MINUTES=30
VIGIL_MAX_BODY_BYTES=524288
VIGIL_MAX_BATCH_LINES=500
VIGIL_INGEST_RATE_PER_MIN=120
VIGIL_LOGIN_RATE_PER_MIN=5
VIGIL_ADMIN_RATE_PER_MIN=600
VIGIL_TRUSTED_PROXY_COUNT=0
VIGIL_RULES_DIR=rules
VIGIL_LOG_LEVEL=INFO
